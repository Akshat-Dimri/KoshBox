# KoshBox — Environment Variables
# Copy this file to .env and fill in values before running in production.
# For local development, all defaults in backend/config.js are used.

# Server
PORT=3001
FRONTEND_PORT=3000
NODE_ENV=development

# Blockchain (Kosh Testnet — leave blank for simulation)
# Fill these in when migrating to Polygon (see docs/polygon-migration.md)
RPC_URL=
CONTRACT_ADDRESS=
MERCHANT_PRIVATE_KEY=
